{
  "name": "demo-restaurante-alcabideche",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Conceito não oficial de landing page para o Restaurante A Ponte (Alvide, Alcabideche), feito para apresentação.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "demo": "astro build && astro preview --host",
    "lint": "eslint . && astro check",
    "test": "node --test \"tests/*.test.*\"",
    "test:e2e": "playwright test",
    "capturas": "node scripts/capturas.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/literata": "5.3.0",
    "astro": "7.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
